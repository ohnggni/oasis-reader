<?xml version="1.0" encoding="utf-8"?>
<!-- Everyone's home server has a different LAN address, so plain http is allowed;
     the server screen warns when an http:// address is entered. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
